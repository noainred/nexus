# Path to the YAML file describing the managed Nexus instances.
# See instances.example.yaml for the format.
NEXUS_MANAGER_INSTANCES_FILE=instances.yaml

# Default HTTP timeout (seconds) for calls to Nexus REST APIs.
NEXUS_MANAGER_REQUEST_TIMEOUT=15

# Verify TLS certificates when talking to Nexus instances (true/false).
NEXUS_MANAGER_VERIFY_TLS=true

# Manager access control. When set, the dashboard runs in "public mode":
# status/monitoring screens are viewable without login, but config changes
# and sensitive data (credential export, audit log, security check, etc.)
# require this password. Leave EMPTY to keep the whole dashboard open.
NEXUS_MANAGER_ADMIN_PASSWORD=
# Audit-log file (every write operation is appended here).
NEXUS_MANAGER_AUDIT_FILE=audit.log

# Alerting: Slack-compatible incoming webhook URL. Empty disables pushing
# (the dashboard's 알림 tab still shows active alerts either way).
NEXUS_MANAGER_ALERT_WEBHOOK=
# How often the background loop re-checks thresholds (seconds).
NEXUS_MANAGER_ALERT_INTERVAL=60
# Heap / disk usage percentages that raise an alert.
NEXUS_MANAGER_ALERT_HEAP_PCT=90
NEXUS_MANAGER_ALERT_DISK_PCT=90

# Infra ping monitoring: CSV log path and measurement interval (seconds).
NEXUS_MANAGER_PING_FILE=ping-history.csv
NEXUS_MANAGER_PING_INTERVAL=60

# Network throughput monitoring: CSV log path. The asset path, daily run time
# and sample size are configured per-deployment in the 서버 설정 tab and stored
# in instances.yaml.
NEXUS_MANAGER_THROUGHPUT_FILE=throughput-history.csv
