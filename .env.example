# Path to the YAML file describing the managed Nexus instances.
# See instances.example.yaml for the format.
NEXUS_MANAGER_INSTANCES_FILE=instances.yaml

# Default HTTP timeout (seconds) for calls to Nexus REST APIs.
NEXUS_MANAGER_REQUEST_TIMEOUT=15

# Verify TLS certificates when talking to Nexus instances (true/false).
NEXUS_MANAGER_VERIFY_TLS=true

# Alerting: Slack-compatible incoming webhook URL. Empty disables pushing
# (the dashboard's 알림 tab still shows active alerts either way).
NEXUS_MANAGER_ALERT_WEBHOOK=
# How often the background loop re-checks thresholds (seconds).
NEXUS_MANAGER_ALERT_INTERVAL=60
# Heap / disk usage percentages that raise an alert.
NEXUS_MANAGER_ALERT_HEAP_PCT=90
NEXUS_MANAGER_ALERT_DISK_PCT=90
