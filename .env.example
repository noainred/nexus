# Path to the YAML file describing the managed Nexus instances.
# See instances.example.yaml for the format.
NEXUS_MANAGER_INSTANCES_FILE=instances.yaml

# Default HTTP timeout (seconds) for calls to Nexus REST APIs.
NEXUS_MANAGER_REQUEST_TIMEOUT=15

# Verify TLS certificates when talking to Nexus instances (true/false).
NEXUS_MANAGER_VERIFY_TLS=true
